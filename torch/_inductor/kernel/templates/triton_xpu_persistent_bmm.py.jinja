{{def_kernel("A", "B")}}
    BATCH = {{size("A", 0)}}
    M = {{size("A", 1)}}
    N = {{size("B", 2)}}
    K = {{size("A", 2)}}

    if (M == 0) or (N == 0):
        # early exit due to zero-size input(s)
        return

    stride_ab = {{stride("A", 0)}}
    stride_am = {{stride("A", 1)}}
    stride_ak = {{stride("A", 2)}}
    stride_bb = {{stride("B", 0)}}
    stride_bk = {{stride("B", 1)}}
    stride_bn = {{stride("B", 2)}}

    start_pid = tl.program_id(0).to(INDEX_DTYPE)
    grid_m = tl.cdiv(M, BLOCK_M)
    grid_n = tl.cdiv(N, BLOCK_N)
    tiles_per_batch = grid_m * grid_n
    num_tiles = BATCH * tiles_per_batch
    width = GROUP_M * grid_n

    # NUM_SMS only caps the launch grid: persistent_bmm_grid launches
    # min(NUM_SMS, num_tiles) work-groups. It is therefore NOT the grid size, and
    # using it raw as the loop stride breaks the grid==stride invariant as soon as
    # num_tiles < NUM_SMS -- which is exactly how the non-persistent variant asks
    # for one work-group per tile (NUM_SMS = 2**30). With num_stages >= 2 the
    # pipeliner peels the next iteration's descriptor_prefetch out of the loop
    # without guarding it against num_tiles, so tile_id + 2**30 makes
    # batch * stride_ab overflow and the prefetch resets the GPU
    # (UR_RESULT_ERROR_DEVICE_LOST). Clamping the stride with the same expression
    # the host grid already uses restores the invariant for both variants; for
    # static shapes min() folds to a constant, so the persistent path generates
    # byte-identical code.
    loop_step = min(NUM_SMS, num_tiles)

    for tile_id in tl.range(start_pid, num_tiles, loop_step):
        batch = tile_id // tiles_per_batch
        batch_tile_id = tile_id % tiles_per_batch

        # re-order program ID for better L2 performance
        group_id = batch_tile_id // width
        group_size = min(grid_m - group_id * GROUP_M, GROUP_M)
        pid_m = group_id * GROUP_M + (batch_tile_id % group_size)
        pid_n = (batch_tile_id % width) // group_size

        # Rank-2 per batch: the batch offset lives in the base pointer, not a 3D descriptor.
        a_desc = tl.make_tensor_descriptor(
            base=A + batch * stride_ab,
            shape=[M, K] if A_ROW_MAJOR else [K, M],
            strides=[stride_am, 1] if A_ROW_MAJOR else [stride_ak, 1],
            block_shape=[BLOCK_M, BLOCK_K] if A_ROW_MAJOR else [BLOCK_K, BLOCK_M],
        )
        b_desc = tl.make_tensor_descriptor(
            base=B + batch * stride_bb,
            shape=[K, N] if B_ROW_MAJOR else [N, K],
            strides=[stride_bk, 1] if B_ROW_MAJOR else [stride_bn, 1],
            block_shape=[BLOCK_K, BLOCK_N] if B_ROW_MAJOR else [BLOCK_N, BLOCK_K],
        )

        rm_desc = (pid_m * BLOCK_M).to(tl.int32)
        rn_desc = (pid_n * BLOCK_N).to(tl.int32)
        acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=ACC_TYPE)
        for k_idx in tl.range(0, tl.cdiv(K, BLOCK_K)):
            # k_idx * BLOCK_K, not the loop IV: XPU's alignment check rejects the IV.
            rk_desc = (k_idx * BLOCK_K).to(tl.int32)
            a = tl.load_tensor_descriptor(
                a_desc,
                [rm_desc, rk_desc] if A_ROW_MAJOR else [rk_desc, rm_desc],
            )
            b = tl.load_tensor_descriptor(
                b_desc,
                [rk_desc, rn_desc] if B_ROW_MAJOR else [rn_desc, rk_desc],
            )
            if USE_FAST_ACCUM:
                acc = tl.dot(
                    a if A_ROW_MAJOR else a.T,
                    b if B_ROW_MAJOR else b.T,
                    acc,
                    allow_tf32=ALLOW_TF32,
                )
            else:
                acc += tl.dot(
                    a if A_ROW_MAJOR else a.T,
                    b if B_ROW_MAJOR else b.T,
                    allow_tf32=ALLOW_TF32,
                )

        {%- if TMA_STORE | default(False) %}

        # Rank-3 descriptor store: the batch block is 1, so a work-group writes
        # its whole [BLOCK_M, BLOCK_N] tile of one batch plane with block stores.
        # A pointer store of the same accumulator degenerates into one scatter
        # store per element, which costs ~4x the scalar ALU ops and L3 write
        # requests and starves the DPAS engine, so prefer this whenever the
        # output layout admits a descriptor.
        # Block indexing takes tile offsets, not element vectors.
        rm = pid_m * BLOCK_M
        rn = pid_n * BLOCK_N
        # The descriptor has a rank-3 block [1, BLOCK_M, BLOCK_N], so the
        # accumulator has to be rank-promoted before the store. Two details are
        # load-bearing for the XPU block-store lowering, both verified on bmm
        # 80x381x640@80x640x1280 at 128,256,64:
        #   - cast to the output dtype *before* reshaping. reshape-then-cast drops
        #     from 4 block stores to 36-75 scatter stores (+5%).
        #   - use reshape, never acc[None, :, :] or tl.broadcast_to; expand_dims
        #     and broadcast values are not recognized either (+10%).
        acc = acc.to(out_ptr0.dtype.element_ty).reshape(1, BLOCK_M, BLOCK_N)
        {{store_output(("batch", "rm", "rn"), "acc", indent_width=8, val_shape=("1", "BLOCK_M", "BLOCK_N"), block_indexing=True)}}
        {%- else %}

        # rematerialize rm and rn to save registers
        rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M).to(INDEX_DTYPE)
        rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N).to(INDEX_DTYPE)
        idx_q = batch
        idx_m = rm[:, None]
        idx_n = rn[None, :]
        mask = (idx_m < M) & (idx_n < N)

        # Pointer store: block_indexing only takes rank-2 outputs without TMA store.
        {{store_output(("idx_q", "idx_m", "idx_n"), "acc", "mask", indent_width=8, val_shape=("BLOCK_M", "BLOCK_N"))}}
        {%- endif %}
        {%- if TILE_BARRIER_MIN_K_STEPS | default(0) %}

        # Keeps a work-group's warps on the same tile when there is no SLM staging.
        if tl.cdiv(num_tiles, loop_step) * tl.cdiv(K, BLOCK_K) >= TILE_BARRIER_MIN_K_STEPS:
            tl.debug_barrier()
        {%- endif %}
